# LoWa Opportunity Engine (/discover). Copy to .env.local for local runs.
# On Vercel, set these in Project Settings > Environment Variables (Preview and Production).
# Never commit real values. The public site works without any of them.

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses row level security.
SUPABASE_SERVICE_ROLE_KEY=

# console.anthropic.com > API keys (set a monthly spend limit)
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5

# Google Cloud > Places API (New). Restrict the key to Places API and set a daily quota.
GOOGLE_PLACES_API_KEY=

# Domain used in proposal links, e.g. https://www.lowa-studio.com (pending: docs/PENDENCIAS.md)
PUBLIC_BASE_URL=
